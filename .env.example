# Copy to .env. Never commit the real file.
# Use a fresh deployer wallet that holds only the gas it needs.
DEPLOYER_PRIVATE_KEY=
BSC_TESTNET_RPC=
BSC_MAINNET_RPC=
BSCSCAN_API_KEY=
# Testnet only: set to true to deploy a mock Agent ID when the official one is not on that network.
USE_MOCK_AGENT_ID=false
